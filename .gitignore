# Build output — the app installs dependencies, so nothing is committed prebuilt.
dist/
out/
release/

# Logs
*.log
logs/

# Audit plugin output
sdlc-audit/

# Temp files
*.tmp
*.bak
*.orig

# Rust build output — the native module is built per platform, never committed.
target/
*.node
