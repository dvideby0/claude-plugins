{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "repo-audit TASKS.json",
  "type": "object",
  "required": ["version", "generated", "summary", "tasks"],
  "properties": {
    "version": { "const": "2.0.0" },
    "generated": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "bySeverity": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "confidence", "category", "source", "files"],
        "properties": {
          "id": { "type": "string", "description": "Finding fingerprint — stable across runs." },
          "title": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "confidence": { "enum": ["definite", "high", "medium", "low"] },
          "category": {
            "enum": [
              "security",
              "correctness",
              "error_handling",
              "performance",
              "types",
              "testing",
              "maintainability",
              "dependencies",
              "documentation"
            ]
          },
          "source": { "enum": ["linter", "typecheck", "secrets", "deps", "graph", "llm"] },
          "files": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Affected files as path or path:line."
          },
          "description": { "type": "string" },
          "suggestion": { "type": "string" },
          "systemic": {
            "type": "boolean",
            "description": "True when one rule fires across three or more files."
          },
          "effort": { "enum": ["small", "medium", "large"] }
        }
      }
    }
  }
}
