{
  "schemaVersion": 2,
  "scenario": "typescript-entry-effect",
  "languages": ["typescript"],
  "features": [
    "cross-file-call",
    "branch",
    "early-return",
    "throw",
    "await",
    "terminal-response"
  ],
  "providers": [
    "native-tree-sitter",
    "native-plus-typescript-checker",
    "scip-typescript"
  ],
  "change": {
    "path": "src/store.ts",
    "append": "\n// EVAL-001 incremental-change probe\n"
  },
  "symbols": [
    { "path": "src/main.ts", "name": "Response", "startLine": 3 },
    { "path": "src/main.ts", "name": "handleAccount", "startLine": 9 },
    { "path": "src/store.ts", "name": "Account", "startLine": 0 },
    { "path": "src/store.ts", "name": "loadAccount", "startLine": 6 }
  ],
  "references": [
    {
      "sourcePath": "src/main.ts",
      "targetPath": "src/store.ts",
      "targetSymbol": "loadAccount"
    }
  ],
  "thresholds": {
    "native-tree-sitter": {
      "symbols": { "minimumPrecision": 1, "minimumRecall": 1 },
      "references": { "minimumPrecision": 1, "minimumRecall": 1 }
    },
    "native-plus-typescript-checker": {
      "symbols": { "minimumPrecision": 1, "minimumRecall": 1 },
      "references": { "minimumPrecision": 1, "minimumRecall": 1 }
    },
    "scip-typescript": {
      "symbols": { "minimumPrecision": 1, "minimumRecall": 1 },
      "references": { "minimumPrecision": 1, "minimumRecall": 1 }
    }
  },
  "scip": {
    "scip-typescript": {
      "documents": 2,
      "minimumDefinitions": 4,
      "minimumReferences": 5,
      "commentSyntax": "//",
      "testFiles": ["src/main.ts", "src/store.ts"]
    }
  }
}
