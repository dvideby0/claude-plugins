        "certainty": "inferred",
        "evidence": { "path": "src/http.ts", "startLine": 7 }
      },
      {
        "id": "normalize-call",
        "kind": "call",
        "source": { "path": "src/http.ts", "symbol": "handleApi" },
        "target": { "path": "src/search.ts", "symbol": "normalizeSearchQuery" },
        "certainty": "inferred",
        "evidence": { "path": "src/http.ts", "startLine": 8 }
