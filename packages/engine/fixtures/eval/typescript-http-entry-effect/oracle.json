    "paths": [
      {
        "id": "normalization-failed",
        "entrypoint": "http:GET:/api/search",
        "relations": ["route-registration", "try-branch", "normalization-response-400"],
        "terminalRelation": "normalization-response-400",
        "conditions": ["try block throws"],
        "certainty": "inferred"
      },
      {
        "id": "invalid-query",
        "entrypoint": "http:GET:/api/search",
        "relations": [
          "route-registration",
          "try-branch",
          "normalize-call",
          "invalid-branch",
          "response-400"
