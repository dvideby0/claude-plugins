    "caught-exception",
    "conditional-branch",
    "await",
    "terminal-response",
    "entry-to-effect-path"
  ],
  "providers": ["native-tree-sitter"],
  "change": {
    "path": "src/search.ts",
    "append": "\n// EVAL-001 incremental-change probe\n"
