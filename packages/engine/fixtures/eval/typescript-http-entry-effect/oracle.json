        "kind": "await",
        "source": { "path": "src/http.ts", "symbol": "handleApi" },
        "target": { "path": "src/search.ts", "symbol": "crossQuery" },
        "certainty": "inferred",
        "evidence": { "path": "src/http.ts", "startLine": 17 }
      },
      {
        "id": "response-200",
        "kind": "terminal-effect",
        "source": { "path": "src/http.ts", "symbol": "handleApi" },
        "target": { "external": "http:response:200" },
        "certainty": "inferred",
        "evidence": { "path": "src/http.ts", "startLine": 18 }
