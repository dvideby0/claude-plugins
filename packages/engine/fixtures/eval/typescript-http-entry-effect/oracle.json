        "kind": "branch",
        "source": { "path": "src/http.ts", "symbol": "handleApi" },
        "target": { "external": "condition:(!term)" },
        "certainty": "inferred",
        "evidence": { "path": "src/http.ts", "startLine": 13 }
      },
      {
        "id": "normalization-response-400",
        "kind": "terminal-effect",
        "source": { "path": "src/http.ts", "symbol": "handleApi" },
        "target": { "external": "http:response:400" },
        "certainty": "inferred",
        "evidence": { "path": "src/http.ts", "startLine": 10 }
      },
      {
        "id": "response-400",
        "kind": "terminal-effect",
        "source": { "path": "src/http.ts", "symbol": "handleApi" },
        "target": { "external": "http:response:400" },
        "certainty": "inferred",
        "evidence": { "path": "src/http.ts", "startLine": 14 }
