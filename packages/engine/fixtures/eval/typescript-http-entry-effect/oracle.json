        "terminalRelation": "response-400",
        "conditions": ["try block completes", "when (!term)"],
        "certainty": "inferred"
      },
      {
        "id": "search-success",
        "entrypoint": "http:GET:/api/search",
        "relations": [
          "route-registration",
          "try-branch",
          "normalize-call",
          "invalid-branch",
          "cross-query-await",
          "response-200"
        ],
        "terminalRelation": "response-200",
        "conditions": ["try block completes", "otherwise ((!term))"],
        "certainty": "inferred"
      }
    ]
  }
