{
  "name": "@sdlc/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Long-lived local code-intelligence engine: indexes repositories and serves them over MCP.",
  "type": "module",
  "main": "./dist/daemon/main.js",
  "bin": {
    "sdlcd": "./dist/daemon/main.js"
  },
  "files": [
    "dist",
    "content",
    "ui"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/daemon/main.js",
    "stdio": "node dist/stdio.js",
    "eval": "node dist/eval/cli.js",
    "eval:joern": "node dist/eval/joern-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @sdlc/scan-core",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sdlc/protocol": "*",
    "@sdlc/scan-core": "*",
    "@sourcegraph/scip-typescript": "^0.4.0",
    "typescript": "^5.8.3",
    "zod": "^3.25.7"
  },
  "devDependencies": {
    "@sourcegraph/scip-python": "0.6.6",
    "@types/node": "^22.15.21",
    "js-tiktoken": "1.0.21",
    "vitest": "^3.0.0"
  }
}
